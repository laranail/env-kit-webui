includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9
    paths:
        - src
    excludePaths:
        # Laravel Nova is paid/opt-in and not installed here, so this one file
        # (which extends a Nova base class) cannot be analysed. It is class_exists-safe
        # at runtime — only loaded when a consumer with Nova references it.
        - src/Adapters/Nova/EnvKitTool.php
    ignoreErrors:
        # The `laranail-env-kit-webui::` view namespace is registered at RUNTIME by the service
        # provider (package-tools' bootPackageViews()), and PHPStan does not execute that — so
        # larastan cannot resolve the literal to a file and reports it as a plain string rather
        # than a view-string. Both views do exist: resources/views/panel.blade.php and
        # resources/views/livewire/env-kit-panel.blade.php.
        - '#expects view-string, string given#'

    # Required BECAUSE of the ignore above: larastan only emits that error from 3.x onward, and
    # `composer update` on CI resolves a newer larastan than a long-lived local vendor/ has. With
    # the default (true), the pattern above is an unmatched-ignore ERROR wherever the older
    # larastan is installed -- so pinning the failure would just move it to the other environment.
    reportUnmatchedIgnoredErrors: false

    tmpDir: .phpstan.cache
